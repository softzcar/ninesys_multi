# Node modules
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Excepción: bitácoras de tareas (logs_gemini/) -- son documentación
# versionada del trabajo realizado, no logs de debug/runtime.
!logs_gemini/*.log

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Nuxt.js build output
.nuxt/
dist/

# Static assets generated at build time
# (static/* en vez de static/ -- un patrón de directorio completo no se
# puede des-ignorar por dentro; con /* sí se puede, ver excepción abajo)
static/*
# Excepción: contenido de las guías de página (common/PageGuide.vue) --
# es contenido editorial versionado, no un artefacto generado.
!static/guias/

# Notas del programador
notes/

# Coveralls test coverage
coverage/

# IDE files
.vscode/
.idea/

# Miscellaneous
.DS_Store
*.swp

# Custom
notas.md 
notes.md 
task.md
# GEMINI.md 

# Deployment scripts and backups
*.sh
backups_transpilaciones/
logs_deploys/
.env
